# Canonical site origin, no trailing slash. Drives canonical URLs, OG tags,
# sitemap.xml, robots.txt and JSON-LD. Defaults to https://growthlabme.com.
NEXT_PUBLIC_SITE_URL=https://growthlabme.com

# Lead capture — Brevo (https://app.brevo.com)
# Copy this file to .env.local and fill in real values. Without BREVO_API_KEY the
# /api/lead route still returns success but only logs the lead (nothing is sent).

# Brevo API key: Brevo dashboard → SMTP & API → API Keys → Generate a new key
BREVO_API_KEY=

# Numeric ID of the Brevo contact list leads are added to
# Contacts → Lists → (your list) → the number in the URL / list settings
BREVO_LIST_ID=

# Verified sender for the transactional email. The domain must be authenticated
# in Brevo (Senders, Domains & Dedicated IPs → Domains) or mail won't send.
BREVO_SENDER_EMAIL=info@growthlabme.com
BREVO_SENDER_NAME=GrowthLab

# Optional override for the "Download your guide" link in the welcome email.
# Defaults to NEXT_PUBLIC_SITE_URL + /growthlab-digital-marketing-guide.pdf
# (served from /public). That same free guide PDF is also attached to the email.
# The full cohort program PDF is download-only from /thank-you, never emailed.
PROGRAM_PDF_URL=

# Analytics — safe to leave blank; each tag only loads once its ID is set.
# GA4 Measurement ID, e.g. G-XXXXXXXXXX  (Admin → Data Streams → your stream)
NEXT_PUBLIC_GA_ID=
# Meta Pixel ID, the numeric ID from Events Manager → Data Sources → your pixel
NEXT_PUBLIC_META_PIXEL_ID=

# Before this works, create one custom contact attribute in Brevo
# (Contacts → Settings → Contact attributes), type "Text":
#   PHONE   — the applicant's phone number
